<?xml version="1.0" encoding="UTF-8"?>
<web-app
    version="4.0"
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:javaee="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
  <display-name>Application blog</display-name>

  <servlet>
    <!-- Имя и класс основного сервлета приложения-->
    <servlet-name>dispatcher</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>

<!--    Настройка multipart-->
    <multipart-config>
      <location>d:/tmp/uploads</location> <!-- Путь для временного хранения файлов -->
      <max-file-size>10485760</max-file-size> <!-- Максимальный размер файла (10MB) -->
      <max-request-size>10485760</max-request-size> <!-- Максимальный размер запроса (10MB) -->
      <file-size-threshold>10485760</file-size-threshold> <!-- Пороговое значение для сохранения файла на диск (10MB) -->
    </multipart-config>

    <!-- Настройка Spring-контекста и Java-конфигурации -->
    <init-param>
      <param-name>contextClass</param-name>
      <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
    </init-param>
    <init-param>
      <param-name>contextConfigLocation</param-name>
      <param-value>org.tasks.WebConfig</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <!-- DispatcherServlet обрабатывает все запросы -->
  <servlet-mapping>
    <servlet-name>dispatcher</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>

</web-app>
